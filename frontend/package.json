{
  "name": "opspilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:knowledge": "node e2e/knowledge-flow.mjs",
    "test:e2e:agent:prepare": "node e2e/agent-flow.mjs prepare",
    "test:e2e:agent:resume": "node e2e/agent-flow.mjs resume",
    "test:e2e:agent:smoke": "node e2e/agent-flow.mjs smoke",
    "test:e2e:agent:intents": "node e2e/agent-flow.mjs intents",
    "test:e2e:conversation:prepare": "node e2e/conversation-flow.mjs prepare",
    "test:e2e:conversation:resume": "node e2e/conversation-flow.mjs resume"
  },
  "dependencies": {
    "element-plus": "^2.11.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  }
}
