# Application
APP_NAME=OpsPilot API
APP_ENV=development
LOG_LEVEL=INFO

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1

# Model generation
LLM_TEMPERATURE=0.2

# Document upload and RAG chunking
# Storage is relative to the project root when using the default.
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Dense retrieval: BGE embedding + local Qdrant
MODEL_CACHE_DIR=storage/models
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_TOKENS=512
EMBEDDING_OVERLAP_TOKENS=64
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
QDRANT_STORAGE_DIR=storage/qdrant
RAG_INDEX_VERSION=1
RAG_RETRIEVAL_DEFAULT_TOP_K=5
RAG_RETRIEVAL_MAX_TOP_K=20
BM25_STORAGE_DIR=storage/bm25
BM25_K1=1.5
BM25_B=0.75
RAG_RRF_K=60
RAG_RRF_CANDIDATE_K=20

# CrossEncoder reranking
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_OVERLAP_TOKENS=32
RERANKER_CANDIDATE_K=20

# RAG answer context
RAG_CONTEXT_MAX_TOKENS=3000
RAG_SOURCE_SUMMARY_CHARS=320

# LangGraph agent
AGENT_MAX_EXECUTION_STEPS=10
AGENT_MAX_TOOL_CALLS=3
TICKET_DATABASE_PATH=storage/tickets.db

